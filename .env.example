# Copy this file to .env and fill in your own key: cp .env.example .env
# .env is in .gitignore; never commit it.

# ElevenLabs API key, needed only to generate audio (scripts/make_audio.py).
# Create one at https://elevenlabs.io/app/settings/api-keys
# It needs access to text to speech, music and sound effects.
ELEVENLABS_API_KEY=

# Optional: the most this project may spend on ElevenLabs in total, in USD (default 20).
# Every paid request is logged in cache/audio/ledger.jsonl; a request that would go past this budget is refused.
# Running scripts/make_audio.py for the whole film costs about $1-2.
# ELEVENLABS_BUDGET_USD=20
